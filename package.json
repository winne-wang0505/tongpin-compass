{
  "name": "compass",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=24.15.0"
  },
  "packageManager": "pnpm@11.19.0",
  "scripts": {
    "dev": "tsx watch server/index.ts",
    "migrate": "tsx server/migrate.ts",
    "build": "tsc --noEmit && vite build && tsc -p tsconfig.server.json",
    "start": "node --env-file-if-exists=.env dist-server/server/index.js",
    "test": "tsx --test tests/*.test.ts",
    "test:e2e": "playwright test",
    "seed": "tsx scripts/seed.ts",
    "migrate:production": "node --env-file-if-exists=.env dist-server/server/migrate.js",
    "backup": "node --env-file-if-exists=.env scripts/backup.mjs",
    "replay-deletions": "node --env-file-if-exists=.env scripts/replay-deletions.mjs"
  },
  "dependencies": {
    "better-auth": "1.7.4",
    "dotenv": "17.4.2",
    "express": "5.2.1",
    "nodemailer": "10.0.3",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "zod": "4.6.2"
  },
  "devDependencies": {
    "@playwright/test": "1.63.0",
    "@types/express": "5.0.6",
    "@types/node": "22.20.2",
    "@types/nodemailer": "8.0.1",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "prettier": "3.9.6",
    "tsx": "4.23.13",
    "typescript": "7.0.2",
    "vite": "8.3.0"
  }
}
